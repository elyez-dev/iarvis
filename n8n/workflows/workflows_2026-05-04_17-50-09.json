gnments":[{"id":"78945b15-dce7-4b68-8b8b-f85a6b3bdb84","name":"user_message","value":"={{ $('Main flow call').item.json.user_message }}","type":"string"},{"id":"36883c1a-5e5c-4a35-8248-a56600a33dd2","name":"tries","value":"={{ $json.body.tries || 0 }}","type":"number"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-800,432],"id":"8712c4b4-5f1a-4acb-b01e-8148c969c299","name":"set tries"},{"parameters":{"method":"POST","url":"http://backend:8000/n8n/archivist_query","sendBody":true,"bodyParameters":{"parameters":[{"name":"=message","value":"={{  $('ARCHIVIST').item.json.toJsonString()}}"},{"name":"tries","value":"={{ $('set tries').item.json.tries || 0 }}"}]},"options":{"response":{"response":{"fullResponse":true,"neverError":true}}}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[-368,432],"id":"bd72b79b-6267-4601-9cc4-4650bad444f8","name":"Syntax check and format","alwaysOutputData":false},{"parameters":{"promptType":"define","text":"={{ $('Main flow call').item.json.user_message }}","messages":{"messageValues":[{"message":"=You are a Data Extraction tool (\"The Archivist\"). Given a user message, extract the personal facts to be saved into two databases: a RAG database (vector semantic) and a graph database (subject-predicate-object).\n\nRules:\n- Output the JSON object specified by the schema. Nothing else.\n- Do not answer the user. Only extract data.\n- For `rag_document`: rewrite as a clear, declarative, third-person sentence. Replace \"I\" / \"my\" with \"the user\" / \"the user's\". The sentence must stand on its own a year from now.\n- For `graph_triplets`: subject-predicate-object tuples (e.g. {\"subject\":\"User\",\"predicate\":\"has_brother\",\"object\":\"Juan\"}).\n- For `time_context`: ISO date or natural descriptor if relevant (today is {{$today}}); empty string if no temporal info.\n\nExamples:\n\nUser: \"I just discovered that my favourite food is garlic bread!\"\nAssistant: {\"rag_document\": \"The user's favorite food is garlic bread.\", \"graph_triplets\": [{\"subject\":\"User\",\"predicate\":\"likes\",\"object\":\"garlic bread\"}], \"time_context\": \"\"}\n\nUser: \"My brother Juan bought a red Toyota yesterday.\"\nAssistant: {\"rag_document\": \"The user's brother Juan bought a red Toyota yesterday.\", \"graph_triplets\": [{\"subject\":\"User\",\"predicate\":\"has_brother\",\"object\":\"Juan\"},{\"subject\":\"Juan\",\"predicate\":\"bought\",\"object\":\"red Toyota\"}], \"time_context\": \"yesterday\"}\n\nUser: \"Remind me that I have a dentist appointment next Tuesday.\"\nAssistant: {\"rag_document\": \"The user has a dentist appointment next Tuesday.\", \"graph_triplets\": [{\"subject\":\"User\",\"predicate\":\"has_appointment\",\"object\":\"dentist\"}], \"time_context\": \"next Tuesday\"}"}]},"batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.9,"position":[-656,432],"id":"04c607e1-9ccd-4545-a280-e41b0573872b","name":"ARCHIVIST","retryOnFail":false,"waitBetweenTries":100},{"parameters":{"model":"qwen2.5:3b","options":{"temperature":0.1,"numCtx":2048,"format":"json"}},"type":"@n8n/n8n-nodes-langchain.lmChatOllama","typeVersion":1,"position":[-656,592],"id":"b0fe298c-10f2-44e1-bcb2-d011cae0252f","name":"Ollama Chat Model","credentials":{"ollamaApi":{"id":"nmLxs50Akyuoz65u","name":"Ollama account"}}}],"connections":{"If Format Error":{"main":[[{"node":"3 max tries","type":"main","index":0}],[]]},"3 max tries":{"main":[[{"node":"Stop and Error","type":"main","index":0}],[{"node":"set tries","type":"main","index":0}]]},"Main flow call":{"main":[[{"node":"set tries","type":"main","index":0}]]},"set tries":{"main":[[{"node":"ARCHIVIST","type":"main","index":0}]]},"Syntax check and format":{"main":[[{"node":"If Format Error","type":"main","index":0}]]},"ARCHIVIST":{"main":[[{"node":"Syntax check and format","type":"main","index":0}]]},"Ollama Chat Model":{"ai_languageModel":[[{"node":"ARCHIVIST","type":"ai_languageModel","index":0}]]}},"setting