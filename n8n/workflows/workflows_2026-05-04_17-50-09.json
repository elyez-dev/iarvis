tion":"strict","version":3},"conditions":[{"id":"afe90035-1eb2-4a5a-91de-efa4e70e97e0","leftValue":"={{ $('Backend Router Validator').item.json.body.tries }}","rightValue":3,"operator":{"type":"number","operation":"gte"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[592,-208],"id":"afc37bf7-bd5b-4eb9-887e-ed7564f2bfaf","name":"3 max tries","retryOnFail":false,"executeOnce":false},{"parameters":{"errorMessage":"The router could not parse the user intention or the request was not valid"},"type":"n8n-nodes-base.stopAndError","typeVersion":1,"position":[800,-224],"id":"4e7b3971-a0ac-4d9d-aede-5fcf704d28e3","name":"Stop and Error"},{"parameters":{"promptType":"define","text":"={{ $json.message }}","messages":{"messageValues":[{"message":"=You are a decision tool for a multi-agent AI system. Given a user message, decide which actions are needed: SEARCH (look up info from the user's personal database), STORE (save info into the user's personal database), TOOL (execute an external integration like email, calendar, etc.), or NONE (regular chat that needs no action).\n\nRules:\n- The database stores personal life facts: relatives, events, preferences, important dates, anything the user shared about their personal life. Use SEARCH or STORE only when this kind of info is involved.\n- TOOL is for external actions (email, calendar, messaging, etc.).\n- NONE is for general chat or questions a regular AI can answer without DB or tools.\n- Do not invent actions. Only the four listed are valid.\n- Combinations are allowed; NONE must appear alone if used.\n\nReply ONLY with the JSON object specified by the schema.\n\nExamples:\n\nUser: \"Hi!\"\nAssistant: {\"actions\": [\"NONE\"]}\n\nUser: \"i want you to remember that i like cheese\"\nAssistant: {\"actions\": [\"STORE\"]}\n\n\"Can you remember that I love chocolate?\"{\"actions\": [\"STORE\"]}\n\n\"Please remember I prefer tea over coffee\"{\"actions\": [\"STORE\"]}\n\n\"Can you remember how much I like chocolate?\"{\"actions\": [\"SEARCH\", \"STORE\"]}\n\nUser: \"Do you remember any food I like?\"\nAssistant: {\"actions\": [\"SEARCH\"]}\n\nUser: \"Remind me which food I like, I also want you to remember I like bacon\"\nAssistant: {\"actions\": [\"SEARCH\", \"STORE\"]}\n\nUser: \"Send an email to my father saying hi\"\nAssistant: {\"actions\": [\"TOOL\"]}\n\nUser: \"I liked Luigi's, add to my Calendar that I'm coming again in 1 month\"\nAssistant: {\"actions\": [\"TOOL\", \"STORE\"]}\n\nUser: \"I want you to email my father with a list of every food I like, also add fries to the list and remember I like them\"\nAssistant: {\"actions\": [\"TOOL\", \"SEARCH\", \"STORE\"]}\n\nUser: \"Tell me the difference between college and university\"\nAssistant: {\"actions\": [\"NONE\"]}\n\nUser: \"I want recommendations about what to eat today for lunch\"\nAssistant: {\"actions\": [\"NONE\"]}"}]},"batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.9,"position":[-48,0],"id":"1e8e5998-e7f4-46c3-be1e-895ea65ea1b8","name":"ROUTER"},{"parameters":{"workflowId":{"__rl":true,"value":"F2aPXErqfTR3DoVh","mode":"list","cachedResultUrl":"/workflow/F2aPXErqfTR3DoVh","cachedResultName":"iarvis_data_search"},"workflowInputs":{"mappingMode":"defineBelow","value":{"user_message":"={{ $('Webhook').item.json.body.message }}"},"matchingColumns":["user_message"],"schema":[{"id":"user_message","displayName":"user_message","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string","removed":false}],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.3,"position":[1040,192],"id":"15a4b846-1c01-407c-9d66-43805b499704","name":"save data"},{"parameters":{"workflowId":{"__rl":true,"value":"4rxiMCMbddUfSUFh","mode":"list","cachedResultUrl":"/workflow/4rxiMCMbddUfSUFh","cachedResultName":"iarvis_data_search"},"workflowInputs":{"mappingMode":"defineBelow","val