gs":[],"shared":[{"updatedAt":"2026-03-03T13:32:16.913Z","createdAt":"2026-03-03T13:32:16.913Z","role":"workflow:owner","workflowId":"jpYQAQTMSdSs5GS4","projectId":"QSiH75mT1tUfjzfP","project":{"updatedAt":"2026-02-11T11:57:48.137Z","createdAt":"2026-02-11T11:45:21.143Z","id":"QSiH75mT1tUfjzfP","name":"Eloy Gonzalez <eloygonzalez@uma.es>","type":"personal","icon":null,"description":null,"creatorId":"cc0147a6-c3e9-4eac-9da0-023bae387669"}}]},{"updatedAt":"2026-05-02T10:22:21.179Z","createdAt":"2026-03-09T14:00:32.823Z","id":"4rxiMCMbddUfSUFh","name":"iarvis_data_search","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"promptType":"define","text":"={{ $('Main flow call').item.json.user_message }}","messages":{"messageValues":[{"message":"=You are a Query Generation tool (\"The Librarian\"). Given a user message, produce search parameters for two databases: a RAG database (vector semantic) and a graph database (entity lookup).\n\nCRITICAL — your output JSON MUST contain ALL THREE fields ALWAYS, never omit any:\n  1. \"rag_query\" (string, required)\n  2. \"graph_entities\" (array of strings, use [] if nothing relevant)\n  3. \"time_context\" (string, use \"\" if no temporal info)\n\nRules:\n- Output the JSON object specified by the schema. Nothing else.\n- Do not answer the user. Only produce the search parameters.\n- For `rag_query`: a clear descriptive sentence optimised for semantic search. Use third-person (\"the user's favorite food\", not \"my favorite food\").\n- For `graph_entities`: list of proper nouns, names, places, key concepts. Empty array [] if nothing truly relevant. Always present.\n- For `time_context`: ISO date or descriptor if temporal (today is {{$today}}); empty string \"\" if no temporal info. Always present, even when empty.\n\nExamples (note that ALL examples include ALL three fields):\n\nUser: \"Can you tell me which is my favourite food?\"\nAssistant: {\"rag_query\": \"user's favorite food\", \"graph_entities\": [\"food\", \"favorite\"], \"time_context\": \"\"}\n\nUser: \"Do I like cheese?\"\nAssistant: {\"rag_query\": \"user's preference for cheese\", \"graph_entities\": [\"cheese\", \"food\"], \"time_context\": \"\"}\n\nUser: \"What did my brother Juan tell me about the car yesterday?\"\nAssistant: {\"rag_query\": \"conversation with the user's brother Juan about the car\", \"graph_entities\": [\"Juan\", \"brother\", \"car\"], \"time_context\": \"yesterday\"}\n\nUser: \"Do I have any meetings scheduled for tomorrow?\"\nAssistant: {\"rag_query\": \"the user's scheduled meetings\", \"graph_entities\": [\"meeting\"], \"time_context\": \"tomorrow\"}"}]},"batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.9,"position":[128,-64],"id":"a3c20ff7-3e30-4aff-82d6-11c26cc4c809","name":"LIBRARIAN","retryOnFail":false,"waitBetweenTries":100},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"17180119-85b2-4aeb-a7e3-4c1360cec6a6","leftValue":"={{ $json.statusCode }}","rightValue":200,"operator":{"type":"number","operation":"notEquals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[576,-64],"id":"64a25f8c-d5c5-4596-8f45-a2048e8c94df","name":"If Format Error"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"1c24a845-9d6e-42aa-b415-3d7e8fab9216","leftValue":"={{ $('Syntax check and format').item.json.body.tries }}","rightValue":3,"operator":{"type":"number","operation":"gte"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[704,-272],"id":"91c295d7-b46f-463f-a160-64e5b3c93020","name":"3 max tries"},{"parameters":{"errorMessage":"The librarian output format was invalid"},"type":"n8n-nodes-base.stopAndError","typeVersion":1,"position":[880,-272],"id":"58711046-01f4-4354-9f76-84df72cf18b2","name":"Stop and Error"}