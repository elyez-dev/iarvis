# ============================================================
# iArvis — Plantilla de variables de entorno
# ============================================================
# Copia este archivo a '.env' y rellena los valores reales:
#   cp .env.example .env
# El archivo .env está en .gitignore — no se commitea.
# ============================================================

# --- URLs internas (red docker) usadas por el backend ---
# Si reescribes la topología (por ejemplo, Ollama en otra máquina)
# cambia estas URLs. Por defecto apuntan a los servicios docker.
OLLAMA_URL=http://ollama:11434
# Para iterar en n8n usa /webhook-test (lee el draft del editor).
# Para 'producción' usa /webhook (lee la última versión publicada).
N8N_WEBHOOK_URL=http://n8n:5678/webhook-test
QDRANT_URL=http://qdrant:6333

# --- Configuración RAG del backend ---
QDRANT_COLLECTION=long_term_memory
EMBEDDING_MODEL=nomic-embed-text:latest

# --- Puertos expuestos al host (host:container) ---
OLLAMA_PORT=11434
N8N_PORT=5678
BACKEND_PORT=8000
PGWEB_PORT=8081
QDRANT_PORT=6333

# --- Ollama runtime ---
# KEEP_ALIVE=-1 mantiene los modelos cargados (no descarga por timeout).
# MAX_LOADED_MODELS limita cuántos modelos en VRAM a la vez.
OLLAMA_KEEP_ALIVE=-1
OLLAMA_MAX_LOADED_MODELS=2

# --- n8n ---
# N8N_PUBLIC_URL es la URL pública con la que n8n compone los webhooks
# que muestra en su UI. Cambiar por la IP/hostname real del servidor.
N8N_HOST=n8n
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://YOUR_PUBLIC_HOST:5678/
N8N_DIAGNOSTICS_ENABLED=false
N8N_SECURE_COOKIE=false

# --- PostgreSQL (historial de chat usado por n8n + pgweb) ---
# Si cambias el password, recuerda eliminar postgres-data/ para
# que la BBDD se inicialice limpia con el nuevo password.
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=changeme-secure-password
POSTGRES_DB=chat_history

# --- RAG ---
# Umbral mínimo de similitud (cosine) para que un resultado de Qdrant pase
# al AGENT. Subir si ves respuestas con datos irrelevantes; bajar para más recall.
# Rango útil 0.3–0.7. Default 0.4.
RAG_SCORE_THRESHOLD=0.68

# Umbral cosine para detectar duplicados al guardar. Si la similitud con un
# doc existente >= este valor, el archivist NO inserta. 0.95 es un buen balance.
RAG_DEDUPE_THRESHOLD=0.95

# --- dgraph (knowledge graph) ---
DGRAPH_HTTP_PORT=8082
DGRAPH_GRPC_PORT=9080
DGRAPH_RATEL_PORT=8001
DGRAPH_GRPC_URL=dgraph:9080
